# Docker startup/config folder is shared by the backend runtime. Keep the
# versioned runtime files below, but ignore every other machine-specific Docker
# launch/config file a developer may create locally.
backend/docker/**
!backend/docker/
!backend/docker/Dockerfile
!backend/docker/docker-compose.yml
!backend/docker/docker-compose.tunnel.yml
!backend/docker/secrets/
backend/docker/secrets/*
!backend/docker/secrets/.gitkeep

/Doc
