# ============================================================
# CareBridge Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# For development, only DJANGO_SECRET_KEY and OPENAI_API_KEY
# are required. Everything else has sensible defaults.
# ============================================================

# --- Django Core ---
DJANGO_SECRET_KEY=your-secret-key-here          # REQUIRED: Generate with `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
DJANGO_ENV=development                           # development | production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,dashboard.carebridge-lab.com
SECURE_SSL_REDIRECT=True                         # Keep True for Cloudflare Tunnel / HTTPS production access.

# Cloudflare Tunnel example for public iOS testing:
#   DJANGO_ENV=production
#   DJANGO_DEBUG=False
#   ALLOWED_HOSTS=api.carebridge-lab.com,dashboard.carebridge-lab.com,localhost,127.0.0.1
#   SECURE_SSL_REDIRECT=True
# The token is copied from Cloudflare Zero Trust when creating the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# --- Database (PostgreSQL) ---
# Only needed for production. Development uses SQLite by default.
DB_NAME=carebridge
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Redis ---
# Only needed when using Celery, Channels, or cache in production.
# Development mode works without Redis.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx              # REQUIRED: Get from https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4o                              # AI chat model (default: gpt-4o)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small    # RAG embedding model

# --- De-identification / DLP ---
# Development can use mock. Production should use google_dlp plus
# Google Application Default Credentials or a mounted service account.
# Docker Compose mounts ${CAREBRIDGE_SECRETS_DIR:-C:/CareBridgeSecrets}
# into both web and celery-worker as /secrets.
DLP_PROVIDER=mock                                # mock | google_dlp
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/secrets/carebridge-dlp.json
GOOGLE_DLP_LOCATION=global
DLP_MIN_LIKELIHOOD=LIKELY
DLP_DELETE_RAW_AFTER_HOURS=24
DLP_INFO_TYPES=EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD_NUMBER,PERSON_NAME,STREET_ADDRESS,DATE_OF_BIRTH,MEDICAL_RECORD_NUMBER,TAIWAN_PHONE_NUMBER,TAIWAN_NATIONAL_ID,TAIWAN_ARC_ID,NHI_CARD_NUMBER,BANK_ACCOUNT

# --- Object Storage (S3 / MinIO) ---
# Docker Compose always uses http://minio:9000 internally.
# The public endpoint controls the host embedded in presigned client URLs.
# For local physical-device testing:
#   AWS_S3_PUBLIC_ENDPOINT_URL=http://100.125.106.32:9000
# For Cloudflare Tunnel:
#   AWS_S3_PUBLIC_ENDPOINT_URL=https://storage.carebridge-lab.com
# For local dev use the MinIO service in docker-compose:
#   AWS_ACCESS_KEY_ID=minioadmin
#   AWS_SECRET_ACCESS_KEY=minioadmin
#   AWS_STORAGE_BUCKET_NAME=carebridge-storage
#   AWS_S3_REGION_NAME=us-east-1
#   AWS_S3_ENDPOINT_URL=http://minio:9000
# For production (real AWS S3) leave AWS_S3_ENDPOINT_URL blank.
# Do not rewrite presigned localhost URLs after generation; the host is part of
# the S3 signature.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=carebridge-storage
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://100.125.106.32:9000

# --- APNs (Apple Push Notifications) ---
# Required for Phase 7-8 push notifications.
# Get from Apple Developer Portal > Keys > Create a new key with APNs.
APNS_AUTH_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX                           # 10-char Key ID from Apple
APNS_TEAM_ID=XXXXXXXXXX                           # 10-char Team ID from Apple
APNS_TOPIC=com.carebridge.app                     # Your app's Bundle ID
APNS_USE_SANDBOX=True                             # True for development, False for production

# --- CORS ---
# iOS URLSession does not need CORS. Keep this restricted for future web clients.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dashboard.carebridge-lab.com,https://shao-zhen.com,http://127.0.0.1:4173,http://localhost:4321

# --- Admin dashboard log retention ---
# Request logs are high-volume request telemetry. Audit logs are lower-volume
# mutation records and are kept longer for admin accountability.
ADMIN_REQUEST_LOG_RETENTION_DAYS=14
ADMIN_AUDIT_LOG_RETENTION_DAYS=180

# --- Email ---
# Only needed if you enable email features (password reset, etc.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
